import os
import pandas as pd
import psycopg2
from psycopg2 import sql, OperationalError

def merge_csv_files(folder_path: str, output_path: str) -> pd.DataFrame:
    """
    Merge all CSV files in a folder into a single DataFrame and save to CSV.

    Args:
        folder_path (str): Path to folder containing CSV files.
        output_path (str): Path to save merged CSV.

    Returns:
        pd.DataFrame: Merged DataFrame.
    """
    dfs = []
    for filename in os.listdir(folder_path):
        if filename.endswith('.csv'):
            file_path = os.path.join(folder_path, filename)
            df = pd.read_csv(file_path)
            # Parse Date column, fallback to default parsing if format unknown
            try:
                df['Date'] = pd.to_datetime(df['Date'], format='%Y-%m-%d')
            except Exception:
                df['Date'] = pd.to_datetime(df['Date'])
            dfs.append(df)

    merged_df = pd.concat(dfs, ignore_index=True)
    merged_df.to_csv(output_path, index=False)
    print(f"Merged CSV saved to {output_path}")
    return merged_df

def load_csv_to_postgres(
    csv_path: str,
    dbname: str,
    user: str,
    password: str,
    host: str = 'localhost',
    port: int = 5432,
    table_name: str = 'public."SP_500_Pricing"'
):
    """
    Load CSV file data into PostgreSQL table using COPY command.

    Args:
        csv_path (str): Path to the CSV file.
        dbname (str): Database name.
        user (str): Username.
        password (str): Password.
        host (str): Hostname or IP address.
        port (int): Port number.
        table_name (str): Target table with schema.
    """
    try:
        conn = psycopg2.connect(dbname=dbname, user=user, password=password, host=host, port=port)
        cur = conn.cursor()
        copy_query = sql.SQL("""
            COPY {table} (date, ticker, open, high, low, close, adj_close, volume, dividends, stock_splits)
            FROM STDIN WITH CSV HEADER DELIMITER ','
        """).format(table=sql.Identifier(*table_name.replace('"', '').split('.')))

        with open(csv_path, 'r') as f:
            cur.copy_expert(copy_query, f)

        conn.commit()
        print("Data loaded successfully into PostgreSQL!")
    except OperationalError as e:
        print(f"Database connection failed: {e}")
    except Exception as e:
        print(f"Failed to load data: {e}")
    finally:
        if 'cur' in locals():
            cur.close()
        if 'conn' in locals():
            conn.close()

