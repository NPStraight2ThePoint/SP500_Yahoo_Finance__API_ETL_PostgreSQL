import yfinance as yf
import pandas as pd
import os
from datetime import date

# Get today's date
today = date.today()

# Read the CSV file into a DataFrame
df = pd.read_csv('/SP500_Tickers.csv')

# Loop through each row in the DataFrame
for index, row in df.iterrows():
      # Define the ticker symbol
      ticker_symbol = row['Symbol']  # Replace with your desired stock ticker

      ticker = yf.Ticker(ticker_symbol)

      # Get all expiration dates
      expiration_dates = ticker.options

      # Initialize an empty DataFrame to hold combined options data
      all_options = pd.DataFrame()

      # Loop through each expiration date
      for expiration in expiration_dates:
          # Fetch the option chain for the current expiration date
          option_chain = ticker.option_chain(expiration)
          calls = option_chain.calls
          puts = option_chain.puts

          # Add expiration date and option type columns
          calls['expirationDate'] = expiration
          calls['optionType'] = 'call'
          puts['expirationDate'] = expiration
          puts['optionType'] = 'put'
          # Add Greeks, expiration date, and other details
          calls['mid_price'] = (calls['bid'] + calls['ask']) / 2
          calls['intrinsicValue'] = calls['lastPrice'] - calls['strike']
          puts['mid_price'] = (puts['bid'] + puts['ask']) / 2
          puts['intrinsicValue'] = puts['lastPrice'] - puts['strike']

          # Combine calls and puts into a single DataFrame
          combined = pd.concat([calls, puts], ignore_index=True)

          # Append the combined data to the main DataFrame
          all_options = pd.concat([all_options, combined], ignore_index=True)

      # Save the combined DataFrame to a CSV file
      output_filename = f"{row['Symbol']}_options_chain_{today}.csv"
      all_options.to_csv(output_filename, index=False)

      print(f"Complete options chain saved to {output_filename}")
