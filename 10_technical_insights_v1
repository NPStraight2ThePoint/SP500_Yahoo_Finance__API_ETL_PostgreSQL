def get_nested_value(data, path):
    keys = path.split("_")
    for key in keys:
        if isinstance(data, list):  # If data is a list, extract the first item
            if data:  # Check if the list is non-empty
                data = data[0]
            else:
                return None  # Return None for an empty list
        if isinstance(data, dict) and key in data:
            data = data[key]
        else:
            return None  # Return None if any key in the path is missing
    return data

# Loop through each row in the DataFrame
for index, row in df.iterrows():

    stock = Ticker(row['Symbol'])

    response = stock.technical_insights

    # Flatten and map the response using the predefined headers
    flattened_data = []
    for symbol, data in response.items():
        row = {}
        for header, path in header_mapping.items():
            row[header] = get_nested_value(data, path)
        flattened_data.append(row)

    # Convert to DataFrame
    df = pd.DataFrame(flattened_data)

    # Display the DataFrame
    print(df)

    # Save the DataFrame to a CSV file
