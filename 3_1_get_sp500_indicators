            stock = yf.Ticker(symbol)
            info_dict = stock.info
        except Exception as e:
            print(f"Failed to get info for {symbol}: {e}")
            continue

        # Convert dict to DataFrame
        df_info = pd.DataFrame.from_dict(info_dict, orient='index', columns=[symbol])
        df_info.index.name = 'Indicator'

        # Add missing indicators with 'NA'
        missing = [c for c in cats if c not in df_info.index]
        if missing:
            missing_df = pd.DataFrame('NA', index=missing, columns=[symbol])
            missing_df.index.name = 'Indicator'
            df_info = pd.concat([df_info, missing_df])

        # Sort by cats order
        df_info['Indicator'] = pd.CategoricalIndex(df_info.index, ordered=True, categories=cats)
        df_info = df_info.sort_values('Indicator')
        df_info = df_info.reset_index()

        # Use date index if you want
        df_info.index = pd.date_range(start=today, periods=len(df_info))
        df_info.index.name = 'Date'

        # Save to CSV
