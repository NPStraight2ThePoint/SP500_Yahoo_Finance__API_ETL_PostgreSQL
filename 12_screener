from yahooquery import Screener

# Initialize the Screener object
s = Screener()

# Get all available screeners
available_screeners = s.available_screeners

# Loop through each screener and fetch data
for screener_name in available_screeners:
    print(f"Fetching data for screener: {screener_name}")

    # Fetch the top 5 results for each screener
    screener_data = s.get_screeners([screener_name], 5)

    # Print the data for the screener
    print(f"Data for {screener_name}:")
    print(screener_data[screener_name])
    print("\n" + "=" * 50 + "\n")
