import os
import pandas as pd

# Folder containing the CSV files
folder_path = "C:/.../SP_500_Pricing"
# List to store individual DataFrames
dataframes = []

# Iterate through all files in the folder
for file in os.listdir(folder_path):
    if file.endswith(".csv"):
        file_path = os.path.join(folder_path, file)
        try:
            # Read the CSV with the first column as the index
            df = pd.read_csv(file_path, index_col=0, parse_dates=True)
            
            # Keep only the 'Adj Close' column
            if 'Adj Close' in df.columns:
                df = df[['Adj Close']]  # Select only the 'Adj Close' column

                # Rename the column to "Adj Close + filename"
                new_column_name = f"Adj Close {os.path.splitext(file)[0]}"
                df.columns = [new_column_name]

                # Append the filtered DataFrame to the list
                dataframes.append(df)
            else:
                print(f"'Adj Close' column not found in {file}, skipping.")
        except Exception as e:
            print(f"Skipping {file} due to error: {e}")

# Merge all DataFrames on their index
merged_df = pd.concat(dataframes, axis=1, join="outer")

# Save the merged DataFrame to a new CSV file
merged_df.to_csv("SP500 Adj.Closes ITD Merged.csv")
print("CSV files merged successfully with only 'Adj Close' columns!")
