import pandas as pd
from yahooquery import Ticker
import os
from datetime import date

# Get today's date
today = date.today()

# Read the CSV file into a DataFrame
df = pd.read_csv('SP500_Tickers.csv')

# Loop through each row in the DataFrame
for index, row in df.iterrows():

    stock = Ticker(row['Symbol'])
    quotes = stock.quotes
    # Access recommendation trends and related info

    if quotes and row['Symbol'] in quotes:
        # Flatten the data
        flattened_data = quotes[row['Symbol']]

        # Convert to a pandas DataFrame
        df = pd.DataFrame([flattened_data])

        # Save to a CSV file
        df.to_csv(f'{row['Symbol']}_quotes_{today}.csv', index=False)
        print(f'Data saved to {row['Symbol']}_quotes.csv')
    else:
        print(f'No data available for {row['Symbol']}.')




