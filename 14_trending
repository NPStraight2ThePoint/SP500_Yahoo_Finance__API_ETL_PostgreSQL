import pandas as pd
import yahooquery as yq

# Fetch trending data
trending_data = yq.get_trending()
print(trending_data)

# Check if 'quotes' exists and contains data
quotes = trending_data.get("quotes", [])
if not quotes:
    print("No trending data available.")
    exit()

# Flatten the data dynamically
def flatten_dict(d, parent_key='', sep='_'):
    """
    Recursively flatten a nested dictionary.
    """
    items = []
    for k, v in d.items():
        new_key = f"{parent_key}{sep}{k}" if parent_key else k
        if isinstance(v, dict):
            items.extend(flatten_dict(v, new_key, sep=sep).items())
        elif isinstance(v, list):
            # Convert lists to strings to avoid breaking DataFrame structure
            items.append((new_key, str(v)))
        else:
            items.append((new_key, v))
    return dict(items)

# Apply flattening to each quote
flattened_data = [flatten_dict(quote) for quote in quotes]

# Convert to DataFrame
df = pd.DataFrame(flattened_data)

# Save to CSV
df.to_csv("trending_all_fields.csv", index=False)

print("Trending data with all fields saved to 'trending_all_fields.csv'")
