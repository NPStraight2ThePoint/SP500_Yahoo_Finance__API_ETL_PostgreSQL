import yfinance as yf
import pandas as pd
import os
from datetime import date

# Get today's date
today = date.today()

# Read the CSV file into a DataFrame
df = pd.read_csv('SP500_Tickers.csv')

# Loop through each row in the DataFrame
for index, row in df.iterrows():

    stock = yf.Ticker(row['Symbol'])

    # Access recommendation trends and related info
    recommendations = stock.recommendations
    # Save to a CSV file
    recommendations.to_csv(f'{row['Symbol']}recommendations_{today}.csv', index=False)

    print(f'{row['Symbol']}Recommendations have been saved to Recommendations.csv')


