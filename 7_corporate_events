from yahooquery import Ticker
import pandas as pd
import os
from datetime import date

# Get today's date
today = date.today()

# Read the CSV file into a DataFrame
df = pd.read_csv('SP500_Tickers.csv')

# Loop through each row in the DataFrame
for index, row in df.iterrows():

    Stock = Ticker(row['Symbol'])
    df = Stock.corporate_events
    df.head()
    print(df.to_string())

    # Save the DataFrame to a CSV file
    df.to_csv(f'{row['Symbol']}_corporate_events{today}.csv', index=True)  # Save to CSV without the index column
    print(f'Corporate events saved to {row['Symbol']}_corporate_events.csv')



