import csv
import os
import pandas as pd
from yahooquery import Ticker
from datetime import date

today = date.today() # Get today's date

# Load the CSV file

df = pd.read_csv('ASX ETF Tickers.csv')
# Read the tickers from the CSV file
with open('ASX ETF Tickers.csv', 'r') as file:
    reader = csv.reader(file)
    tickers = [row[0].strip() for row in reader if row]  # Extract and clean tickers

# Convert the list of tickers into a space-separated string
ticker_string = ' '.join(tickers)

# Use the Ticker class from yahooquery with the imported tickers
funds = Ticker(ticker_string)
# Create a dictionary to store all data
data = {
    'Fund Bond Holdings': funds.fund_bond_holdings,
    'Fund Equity Holdings': funds.fund_equity_holdings,
    'Fund Holding Info': funds.fund_holding_info,
    'Fund Performance': funds.fund_performance,
    'Fund Profile': funds.fund_profile,
}

# Define the base directory with an absolute path where subfolders will be created
base_directory = 'Root/Fund Data'  # Update this path as needed

# Make sure the base directory exists
os.makedirs(base_directory, exist_ok=True)
# Now you can loop through each ticker
for ticker in tickers:
    # Create a dictionary to store the ticker's specific data
    ticker_data = {}

    # Extract only the data related to the current ticker
    for key, value in data.items():
        # Check if the data exists for the ticker and is not empty
        ticker_specific_data = value.get(ticker) if isinstance(value, dict) else value
        if isinstance(ticker_specific_data, pd.DataFrame) and not ticker_specific_data.empty:
            ticker_data[key] = ticker_specific_data
        elif isinstance(ticker_specific_data, dict) and ticker_specific_data:  # For dictionary-based data
            df = pd.json_normalize(ticker_specific_data)
            if not df.empty:
                ticker_data[key] = df

    # Now save the data for this ticker to separate CSV files for each section
    for section_name, df in ticker_data.items():
        # Create the subfolder path inside the base directory
        folder_name = os.path.join(base_directory, f'{section_name}_data')
        os.makedirs(folder_name, exist_ok=True)  # Create the folder if it doesn't exist

        # Save the section to a CSV file inside the corresponding subfolder
        df.to_csv(os.path.join(folder_name, f'{ticker}_{section_name}_{today}.csv'), index=False)
        print(f'{ticker}_{section_name}_Saved')

