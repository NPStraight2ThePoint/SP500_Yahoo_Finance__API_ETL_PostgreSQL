import pandas as pd
import glob
import os
from datetime import date
import psycopg2

# File & folder setup
today = date.today()
folder_path = 'Root/SP_500_Company_Info'
output_dir = 'Root/Joined_Data'

all_files = glob.glob(os.path.join(folder_path, "*.csv"))

dfs = []
for file in all_files:
    temp_df = pd.read_csv(file)
    date_col = [col for col in temp_df.columns if 'Date' in col or 'Unnamed' in col]
    if date_col:
        temp_df = temp_df.rename(columns={date_col[0]: 'Date'})
        temp_df['Date'] = pd.to_datetime(temp_df['Date'])
        temp_df.set_index('Date', inplace=True)
    else:
        continue

    ticker = os.path.splitext(os.path.basename(file))[0]
    temp_df.columns = [ticker]
    dfs.append(temp_df)

merged_df = pd.concat(dfs, axis=1, join='outer').sort_index()

os.makedirs(output_dir, exist_ok=True)
output_file = os.path.join(output_dir, f'sp500_joined_CompanyInfo_{today}.csv')
merged_df.to_csv(output_file)

print(f"All CSV files merged and saved to {output_file}")

# Reshape wide to long
df_long = merged_df.reset_index().melt(id_vars=['Date'], var_name='Ticker', value_name='Value')
print(df_long.head())

long_output_file = os.path.join(output_dir, f'sp500_joined_CompanyInfo_long_{today}.csv')
df_long.to_csv(long_output_file, index=False)
print(f"Long format data saved to {long_output_file}")

# === Load to PostgreSQL ===

# DB connection parameters (update as needed)
dbname = 'Yahoo_Finance_API'
user = 'postgres'
password = ''  # Add your password here
host = 'localhost'
port = '5432'  # Default PostgreSQL port

# Connect to PostgreSQL
conn = psycopg2.connect(dbname=dbname, user=user, password=password, host=host, port=port)
cur = conn.cursor()

# Copy data from CSV into DB table
with open(long_output_file, 'r', encoding='utf-8') as f:
    next(f)  # Skip header row
    cur.copy_from(f, 'public.sp500_company_info', sep=',', columns=('date', 'ticker', 'value'))

conn.commit()
cur.close()
conn.close()

print("Data loaded successfully into PostgreSQL!")


